{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "boutique.dynastiedorkhan.com",
    "rdv.dynastiedorkhan.com"
  ],
  "redirects": [
    {
      "source": "/medailles-gravees/conditions-vente.html",
      "destination": "/conditions-generales-de-vente/",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/confidentialite.html",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/mentions-legales.html",
      "destination": "/mentions-legales/",
      "permanent": true
    },
    {
      "source": "/demande-de-rdv/:path*",
      "has": [
        {
          "type": "host",
          "value": "boutique.dynastiedorkhan.com"
        }
      ],
      "destination": "https://rdv.dynastiedorkhan.com/demande-de-rdv/:path*",
      "permanent": true
    },
    {
      "source": "/cosmetiques/:path*",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/cosmetiques/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        },
        {
          "type": "header",
          "key": "referer",
          "value": "https://rdv\\.dynastiedorkhan\\.com/demande-de-rdv/?.*"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://rdv.dynastiedorkhan.com/demande-de-rdv/",
      "permanent": true
    }
  ]
}
