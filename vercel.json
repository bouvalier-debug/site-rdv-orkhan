{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "boutique.dynastiedorkhan.com",
    "rdv.dynastiedorkhan.com"
  ],
  "redirects": [
    {
      "source": "/medailles-gravees",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/medailles-gravees/",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/medailles-gravees/",
      "permanent": true
    },
    {
      "source": "/rayons/:path*",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/rayons/:path*",
      "permanent": true
    },
    {
      "source": "/produits/:path*",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/produits/:path*",
      "permanent": true
    },
    {
      "source": "/sur-demande/:path*",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/sur-demande/:path*",
      "permanent": true
    },
    {
      "source": "/sur-demande",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/sur-demande",
      "permanent": true
    },
    {
      "source": "/nouveautes",
      "destination": "/#nouveautes",
      "permanent": true
    },
    {
      "source": "/nouveautes/",
      "destination": "/#nouveautes",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/conditions-vente.html",
      "destination": "/conditions-generales-de-vente/",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/confidentialite.html",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/medailles-gravees/mentions-legales.html",
      "destination": "/mentions-legales/",
      "permanent": true
    },
    {
      "source": "/demande-de-rdv/:path*",
      "has": [
        {
          "type": "host",
          "value": "boutique.dynastiedorkhan.com"
        }
      ],
      "destination": "https://rdv.dynastiedorkhan.com/demande-de-rdv/:path*",
      "permanent": true
    },
    {
      "source": "/cosmetiques/:path*",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/cosmetiques/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        },
        {
          "type": "header",
          "key": "referer",
          "value": "https://rdv\\.dynastiedorkhan\\.com/demande-de-rdv/?.*"
        }
      ],
      "destination": "https://boutique.dynastiedorkhan.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "https://rdv.dynastiedorkhan.com/demande-de-rdv/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/vitrine?vue=accueil"
    },
    {
      "source": "/rayons/:rayon",
      "destination": "/api/vitrine?vue=rayon&rayon=:rayon"
    },
    {
      "source": "/rayons/:rayon/",
      "destination": "/api/vitrine?vue=rayon&rayon=:rayon"
    },
    {
      "source": "/sur-demande",
      "destination": "/api/vitrine?vue=sur-demande"
    },
    {
      "source": "/sur-demande/",
      "destination": "/api/vitrine?vue=sur-demande"
    },
    {
      "source": "/produits/:fiche",
      "destination": "/api/vitrine?vue=produit&fiche=:fiche"
    },
    {
      "source": "/produits/:fiche/",
      "destination": "/api/vitrine?vue=produit&fiche=:fiche"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "/seo/sitemap-rdv.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/vitrine?vue=sitemap"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "rdv.dynastiedorkhan.com"
        }
      ],
      "destination": "/seo/robots-rdv.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots-boutique.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://player.vimeo.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src https://player.vimeo.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "test-boutique.dynastiedorkhan.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/vitrine.js": {
      "includeFiles": "seo/sitemap-boutique.xml"
    }
  }
}
